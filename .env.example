# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (local stack: `pnpm exec supabase status` prints these)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy-anon-key
# Optional. Public origin used in auth redirect URLs; defaults to the request origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Used to sign short-lived app_ai_writer JWTs (DM-13). At least 32 characters.
SUPABASE_JWT_SECRET=dummy-jwt-secret-at-least-32-characters-long

# Service role key: ONLY in src/server/jobs/service-role.ts — the AI jobs cron (stalled sweep +
# due-job lookup), the retention cron (purge RPCs), and account deletion (auth.admin.deleteUser).
# Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key

# AI (BYOK): there is no service-wide LLM key — users bring their own (D-28).
# Users' keys are stored envelope-encrypted (DM 2.11.2). Key-encryption key (KEK):
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`), and its id/version.
# ⚠️ PRE-LAUNCH STAND-IN (decisions B-2): replace with a cloud KMS before launch
# (src/server/keys/kms.ts). Changing the KEK makes stored keys undecryptable unless
# DEKs are re-wrapped; keep the id in step with the key.
# Left EMPTY on purpose (QA-S3b-04): never ship a published example key. Empty = key
# registration and AI runs fail closed; generate your own value in .env.local.
AI_KEY_KEK_BASE64=
AI_KEY_KEK_ID=env-v1

# Account deletion (S9): HMAC key for the de-identified deletion log
# (account_deletion_logs.subject_hash, D-DM-02). At least 32 random characters
# (e.g. `openssl rand -base64 48`). Left EMPTY on purpose: empty = account
# deletion fails closed (nothing is deleted); set your own value in .env.local.
ACCOUNT_DELETION_HASH_SECRET=

# Development only (optional): run AI with one env key instead of a registered key.
# When BOTH are set (outside production) the job runner ignores stored keys.
# Ignored in production. Never commit a real key; put it in .env.local.
# AI_DEV_PROVIDER=gemini
# AI_DEV_API_KEY=dummy-dev-provider-key
# free | paid (free = sequential runs + call spacing, AI C-12)
# AI_DEV_CONNECTION_TIER=free

# Vercel Cron bearer token for /api/cron/*. At least 16 characters.
CRON_SECRET=dummy-cron-secret-0000

# Supabase local Auth — Google provider (supabase/config.toml [auth.external.google], disabled by default).
# Read by the Supabase CLI, not by the Next.js app. Put real values in supabase/.env (gitignored).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=dummy-google-client-secret
