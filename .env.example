# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (local stack: `pnpm exec supabase status` prints these)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy-anon-key
# Optional. Public origin used in auth redirect URLs; defaults to the request origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Used to sign short-lived app_ai_writer JWTs (DM-13). At least 32 characters.
SUPABASE_JWT_SECRET=dummy-jwt-secret-at-least-32-characters-long

# Service role key: ONLY for the AI jobs cron (stalled sweep + due-job lookup, src/server/jobs/cron.ts). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key

# AI (BYOK): there is no service-wide LLM key — users bring their own (D-28).
# Development only, before S3b key storage: one provider + key for local runs.
# Ignored in production. Never commit a real key; put it in .env.local.
AI_DEV_PROVIDER=gemini
AI_DEV_API_KEY=dummy-dev-provider-key
# free | paid (free = sequential runs + call spacing, AI C-12)
AI_DEV_CONNECTION_TIER=free

# Vercel Cron bearer token for /api/cron/*. At least 16 characters.
CRON_SECRET=dummy-cron-secret-0000

# Supabase local Auth — Google provider (supabase/config.toml [auth.external.google], disabled by default).
# Read by the Supabase CLI, not by the Next.js app. Put real values in supabase/.env (gitignored).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=dummy-google-client-secret
